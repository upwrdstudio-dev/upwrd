// Cloudflare Workers config: serves the Vite build as static assets.
// "name" must match the Worker in the Cloudflare dashboard.
{
  "name": "upwrd",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // Every route is prerendered to its own HTML file (scripts/prerender-meta.mjs),
    // so only genuinely unknown paths reach this: they get 404.html with a real
    // 404 status, rather than a copy of the homepage (a "soft 404" to Google).
    "not_found_handling": "404-page"
  }
}
